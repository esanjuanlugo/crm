pipeline {
    agent any

    stages {
        stage('Verificar entorno') {
            steps {
                sh '''
                    set -e

                    echo "=== Usuario ==="
                    whoami

                    echo "=== Docker ==="
                    docker --version
                    docker compose version

                    echo "=== Supabase CLI ==="
                    npx supabase --version

                    echo "=== Proyecto ==="
                    cd /home/ubuntu/crm/crm
                    pwd

                    echo "=== Estado Docker ==="
                    docker compose ps
                '''
            }
        }

        stage('Actualizar código') {
            steps {
                sh '''
                    set -e

                    cd /home/ubuntu/crm/crm

                    echo "=== Actualizando código ==="
                    git pull origin main
                '''
            }
        }

        stage('Actualizar base de datos') {
            steps {
                sh '''
                    set -e

                    cd /home/ubuntu/crm/crm

                    echo "=== Verificando migraciones ==="
                    npx supabase migration list --project-ref fhhzhpsydqnimzirprac

                    echo "=== Actualizando base de datos Supabase ==="
                    npx supabase db push --project-ref fhhzhpsydqnimzirprac

                    echo "=== Base de datos actualizada ==="
                '''
            }
        }

        stage('Build y Deploy') {
            steps {
                sh '''
                    set -e

                    cd /home/ubuntu/crm/crm

                    echo "=== Construyendo y desplegando ==="
                    docker compose up -d --build
                '''
            }
        }

        stage('Verificar aplicación') {
            steps {
                sh '''
                    set -e

                    cd /home/ubuntu/crm/crm

                    echo "=== Estado final ==="
                    docker compose ps
                '''
            }
        }
    }

    post {
        success {
            echo 'Despliegue completado correctamente.'
        }

        failure {
            echo 'El despliegue falló.'
        }
    }
}
